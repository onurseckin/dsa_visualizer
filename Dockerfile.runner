# syntax=docker/dockerfile:1
FROM python:3.12.10-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/tmp

RUN pip install --no-cache-dir numpy==2.2.5 \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.6.0+cpu \
    && groupadd --gid 10001 runner \
    && useradd --uid 10001 --gid runner --create-home --home-dir /home/runner --shell /usr/sbin/nologin runner

WORKDIR /app
COPY --chown=runner:runner apps/python-runner /app

USER 10001:10001
EXPOSE 8080
CMD ["python", "runner_service.py"]
