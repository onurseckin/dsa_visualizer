# syntax=docker/dockerfile:1
FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/tmp

ARG TARGETARCH
COPY docker/python-runner/requirements-linux-amd64.txt /tmp/requirements-linux-amd64.txt
COPY docker/python-runner/requirements-linux-arm64.txt /tmp/requirements-linux-arm64.txt
RUN case "$TARGETARCH" in \
      amd64) requirements=/tmp/requirements-linux-amd64.txt ;; \
      arm64) requirements=/tmp/requirements-linux-arm64.txt ;; \
      *) echo "Unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && pip install --no-cache-dir --require-hashes -r "$requirements" \
    && groupadd --gid 10001 runner \
    && useradd --uid 10001 --gid runner --create-home --home-dir /home/runner --shell /usr/sbin/nologin runner

WORKDIR /app
COPY --chown=runner:runner apps/python-runner /app

USER 10001:10001
EXPOSE 8080
CMD ["python", "runner_service.py"]
