{
  "name": "dsa-visualizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/freePort.ts 5173 && vite",
    "typecheck": "tsc --noEmit",
    "generate-routes": "tsr generate",
    "lint": "oxlint --threads 8 --deny-warnings",
    "format": "oxfmt --write --threads 8",
    "format:check": "oxfmt --check --threads 8",
    "test": "vitest run --maxConcurrency 8",
    "build": "tsc && vite build",
    "preview": "bun run scripts/freePort.ts 4173 && vite preview",
    "start": "bun run scripts/freePort.ts 4173 && vite preview",
    "kill-ports": "bun run scripts/freePort.ts 5173 4173",
    "check": "bun run typecheck && bun run format:check && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "lucide-react": "^0.344.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.9",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/router-cli": "^1.167.21",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "1.3.1",
    "jsdom": "^24.0.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vite": "^5.1.4",
    "vitest": "^1.3.1"
  }
}
