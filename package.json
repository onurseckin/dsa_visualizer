{
  "name": "dsa-visualizer",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "start": "docker compose up --build --watch",
    "dev": "docker compose up --build --watch",
    "stop": "docker compose down",
    "restart": "bun run stop && bun run start",
    "logs": "docker compose logs --follow",
    "ps": "docker compose ps",
    "shell:web": "docker compose exec web sh",
    "shell:api": "docker compose exec api sh",
    "shell:runner": "docker compose exec python-runner sh",
    "clean": "docker compose down --volumes",
    "dev:local": "bun run scripts/freePort.ts 42000 && vite --port 42000",
    "start:local": "bun run dev:local",
    "typecheck": "tsc --noEmit",
    "generate-routes": "tsr generate",
    "lint": "oxlint --threads 8 --deny-warnings",
    "format": "oxfmt --write --threads 8",
    "format:check": "oxfmt --check --threads 8",
    "intent:check": "bun run scripts/checkIntentSkills.ts",
    "compose:check": "bun run scripts/checkCompose.ts",
    "audit:catalog": "bun run scripts/auditCatalog.ts",
    "audit:visualizers": "bun run scripts/auditVisualizers.ts",
    "modularity:staged": "bun scripts/modularity/check.ts --mode ratchet --source index",
    "modularity:check": "bun scripts/modularity/check.ts --mode ratchet --source tree",
    "build": "tsc && vite build",
    "kill-ports:local": "bun run scripts/freePort.ts 42000 42173",
    "check": "bun run typecheck && bun run format:check && bun run lint && bun run intent:check && bun run compose:check && bun run audit:catalog && bun run modularity:check && bun run build"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.1",
    "@dsa-visualizer/execution-contracts": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "lucide-react": "^0.344.0",
    "pyodide": "314.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.9",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/router-cli": "^1.167.21",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vite": "^5.1.4",
    "vite-plugin-static-copy": "3.1.4"
  },
  "intent": {
    "skills": [
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/virtual-file-routes"
    ]
  }
}
